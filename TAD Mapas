def binary_search(entries,key):
    left = 0
    right = size(entries)-1

    while left <= right:
        middle = (left + right) // 2
        middle_key = entries[middle]["key"]

        if middle_key == key:
            return middle
        if middle_key < key:
            left = middle + 1
        else:
            right = middle - 1
    
    return -1
